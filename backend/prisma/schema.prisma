model User {
  // ... existing fields
  role         String    @default("free") // 'free', 'pro', 'school'
  subscription Plan?     @default(FREE)
  lessonsUsed  Int       @default(0)
  lessonsLimit Int       @default(5)
  schemesUsed  Int       @default(0)
  schemesLimit Int       @default(3)
  subscriptionEndsAt DateTime?
}

model Payment {
  // ... existing fields
  plan         String    @default("free") // 'free', 'pro', 'school'
  amount       Float
  status       String    @default("pending") // 'pending', 'completed', 'failed'
  expiresAt    DateTime?
}

enum Plan {
  FREE
  PRO
  SCHOOL
}
