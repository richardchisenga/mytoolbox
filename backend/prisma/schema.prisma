model Lesson {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade           String
  subject         String
  topic           String
  subtopic        String?   // ✅ Added back
  title           String?
  classSize       Int       @default(40)
  duration        String    @default("40 min")
  curriculum      String    @default("cbc")
  teacherName     String?
  school          String?
  province        String?
  district        String?
  date            String?
  time            String?
  boys            Int?
  girls           Int?
  generalCompetences String[]
  specificCompetence String?
  lessonGoal      String?
  rationale       String?
  priorKnowledge  String?
  references      String[]
  learningEnvironment String?
  materials       String[]
  expectedStandard String?
  lessonProgression Json?
  homework        String?
  lessonEvaluation String?
  teacherEvaluation String?
  learningOutcomes String[]
  lessonDevelopment Json?
  learnersEvaluation String[]
  teachingAids    String[]
  objectives      String[]
  development     String[]
  activities      String[]
  assessment      String
  curriculumCodes String[]
  provinceContext String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
