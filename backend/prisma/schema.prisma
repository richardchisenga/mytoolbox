generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  passwordHash String
  school       String
  province     String
  district     String
  grades       String[]
  subjects     String[]
  role         String    @default("free")
  status       String    @default("active")
  lastActive   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lessons      Lesson[]
  schemes      Scheme[]
  payments     Payment[]
  posts        Post[]
}

model Lesson {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade           String
  subject         String
  topic           String
  title           String?
  classSize       Int       @default(40)
  duration        String    @default("40 min")
  curriculum      String    @default("cbc")
  status          String    @default("draft")
  
  // CBC fields
  teacherName     String?
  date            String?
  time            String?
  boys            Int?
  girls           Int?
  generalCompetences String[]
  specificCompetence String?
  lessonGoal      String?
  rationale       String?
  priorKnowledge  String?
  references      String[]
  learningEnvironment String?
  materials       String[]
  expectedStandard String?
  lessonProgression Json?
  homework        String?
  lessonEvaluation String?
  
  // OBC fields
  learningOutcomes String[]
  lessonDevelopment Json?
  learnersEvaluation String[]
  teachingAids    String[]
  
  objectives      String[]
  development     String[]
  activities      String[]
  assessment      String
  curriculumCodes String[]
  provinceContext String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Scheme {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  school       String    @default("KASHINAKAZHI SECONDARY SCHOOL")
  grade        String
  subject      String
  term         String
  year         String    @default("2026")
  totalWeeks   Int       @default(13)
  weeks        Json
  status       String    @default("draft")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Payment {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId  String    @unique
  transactionId String   @unique
  amount       Float
  currency     String    @default("ZMW")
  plan         String    @default("pro") // pro, school
  provider     String    // mtn, airtel, zamtel
  phoneNumber  String
  status       String    @default("pending") // pending, completed, failed
  externalId   String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
}

model Post {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String
  type         String    // tip, lesson, resource, question
  subject      String?
  grade        String?
  tags         String[]
  likes        Int       @default(0)
  shares       Int       @default(0)
  status       String    @default("published")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  comments     Comment[]
}

model Comment {
  id           String    @id @default(cuid())
  postId       String
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String
  createdAt    DateTime  @default(now())
}
